# Local development
DATABASE_URL=postgresql+psycopg2://marketwatch:marketwatch@127.0.0.1:5432/marketwatch
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=local-dev-only-not-for-production-0001
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=
PUBLIC_APP_URL=http://127.0.0.1:43123
CACHE_TTL_SECONDS=60
SNAPSHOT_REFRESH_SECONDS=120
LIVE_MAX_AGE_SECONDS=300
DELAYED_MAX_AGE_SECONDS=1200
STALE_MAX_AGE_SECONDS=86400
SNAPSHOT_RETENTION_DAYS=14
AUTH_RATE_LIMIT_PER_MINUTE=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# Production (Vercel / any host): set ENVIRONMENT=production,
# a 32+ character SECRET_KEY that is not a committed example,
# and a persistent Postgres DATABASE_URL. SQLite is rejected in production.
