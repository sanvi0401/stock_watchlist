# Copy to backend/.env (or export). Every value has a working default for local development.

# Persistence. Default: SQLite file at backend/marketwatch.db (zero setup).
# Production / multi-instance: Postgres, e.g. from `docker compose up -d`:
# DATABASE_URL=postgresql+psycopg2://marketwatch:marketwatch@127.0.0.1:5432/marketwatch

# Quote cache. If Redis is unreachable the API falls back to an in-process TTL cache.
REDIS_URL=redis://127.0.0.1:6379/0

# Required in production (startup fails on the default value).
SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=development

CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
PUBLIC_APP_URL=http://127.0.0.1:43123

# yfinance (default, delayed Yahoo data) | yahoo_http (no pandas; used on Vercel) | mock (offline, deterministic) | alpha_vantage
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=

CACHE_TTL_SECONDS=60
SNAPSHOT_REFRESH_SECONDS=120
# Dashboard loads within this many minutes count as one visit (baseline does not move).
CHECK_SESSION_MINUTES=10
# While the market is open, quotes older than this are labelled STALE.
STALE_AFTER_MINUTES=20
MAX_SYMBOLS_PER_WATCHLIST=100
